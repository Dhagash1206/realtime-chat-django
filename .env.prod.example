# Copy to .env.prod and fill in real values. Never commit .env.prod.
DJANGO_SECRET_KEY=generate-with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=chat.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://chat.example.com
# HTTPS-only cookies + redirect. Set to 0 only when testing over plain HTTP locally.
DJANGO_HTTPS=1
# Enable once HTTPS is confirmed working (e.g. 31536000 = 1 year)
DJANGO_HSTS_SECONDS=0

POSTGRES_DB=chat
POSTGRES_USER=chat
POSTGRES_PASSWORD=use-a-strong-unique-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0

WEB_CONCURRENCY=2
LOG_LEVEL=INFO
AUTH_TOKEN_TTL_SECONDS=604800
